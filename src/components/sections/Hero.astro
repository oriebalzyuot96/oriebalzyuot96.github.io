---
import { useT } from '../../i18n';
const t = useT(Astro.currentLocale);
const pre = Astro.currentLocale === 'ar' ? '/ar' : '';
---
<section class="hero" id="home" aria-labelledby="heroTitle">
  <div class="aurora" aria-hidden="true" data-parallax="0.18"><i></i><i></i><i></i></div>
  <div class="grid-dots" aria-hidden="true" data-parallax="0.08"></div>
  <canvas class="stars" id="stars" aria-hidden="true"></canvas>
  <div class="hero-orb" aria-hidden="true" data-parallax="0.3"></div>
  <button class="fx-toggle" id="fxToggle" type="button" aria-pressed="false" title={t('fx.pause')}>
    <svg class="i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1.2"></rect><rect x="14" y="5" width="4" height="14" rx="1.2"></rect></svg>
    <svg class="i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg>
    <span data-pause-label={t('fx.pause')} data-play-label={t('fx.play')}><Fragment set:html={t('fx.pause')} /></span>
  </button>
  <div class="wrap">
    <div class="hero-head">
      <span class="hello stagger" style="--i:0"><img src="/assets/orieb-face.jpg" alt="" width="30" height="30"><span><Fragment set:html={t('hero.hello')} /></span> · <span class="live"><Fragment set:html={t('hero.open')} /></span></span>
      <h1 id="heroTitle"><span class="line stagger" style="--i:1"><Fragment set:html={t('hero.l1')} /></span> <span class="line stagger" style="--i:2"><span><Fragment set:html={t('hero.l2a')} /></span> <span class="rot" id="rot" data-words={t('hero.words')}><span class="w">{t('hero.words').split('|')[0]}</span></span><span><Fragment set:html={t('hero.l2b')} /></span></span> <span class="line stagger" style="--i:3"><Fragment set:html={t('hero.l3')} /></span></h1>
      <p class="lede stagger" style="--i:4"><Fragment set:html={t('hero.lede')} /></p>
      <div class="cta stagger" style="--i:5">
        <a class="btn primary magnet" href={`${pre}/work/`}><span><Fragment set:html={t('hero.cta1')} /></span> <svg class="flip-rtl" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        <a class="btn magnet" href="/Orieb-Alzyuot-CV.pdf" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 3v12m0 0l-5-5m5 5l5-5M5 21h14"></path></svg><span><Fragment set:html={t('hero.cta3')} /></span></a>
        <a class="btn magnet" href={`${pre}/hire/`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="M3 7l9 6 9-6"></path></svg><span><Fragment set:html={t('hero.cta4')} /></span></a>
      </div>
    </div>

    <!-- 3D studio desk: her real projects on a laptop + phone, skill cards and tech tokens.
         The still image is the no-WebGL / reduced-motion version; the canvas fades in over it (fixed height, no CLS). -->
    <div class="studio">
      <div class="hero3d" id="hero3d" aria-hidden="true">
        <picture class="studio-still lt"><source media="(max-width: 640px)" srcset="/assets/studio/still-light-m.webp" width="800" height="760"><img src="/assets/studio/still-light.webp" alt="" width="1600" height="720" loading="lazy" decoding="async" fetchpriority="low"></picture>
        <picture class="studio-still dk"><source media="(max-width: 640px)" srcset="/assets/studio/still-dark-m.webp" width="800" height="760"><img src="/assets/studio/still-dark.webp" alt="" width="1600" height="720" loading="lazy" decoding="async" fetchpriority="low"></picture>
      </div>
      <a class="studio-link" href={`${pre}/work/`}><Fragment set:html={t('studio.link')} /></a>
    </div>
  </div>
</section>
