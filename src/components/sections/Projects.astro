          <ul class="hl"><li><Fragment set:html={t('sba.h1')} /></li><li><Fragment set:html={t('sba.h2')} /></li><li><Fragment set:html={t('sba.h3')} /></li></ul>
          <div class="tags"><span class="tag">Angular</span><span class="tag">.NET Core</span><span class="tag">PostgreSQL</span><span class="tag">RTL</span><span class="tag">WCAG</span></div>
          <div class="p-actions"><button class="btn primary" data-case="p-sba"><Fragment set:html={t('btn.case')} /></button><a class="btn" href="https://qccx.sba.gov.sa/" target="_blank" rel="noopener"><Fragment set:html={t('btn.visit')} /></a></div>
