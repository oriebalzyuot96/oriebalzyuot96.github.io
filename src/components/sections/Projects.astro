        <div class="media">
          <figure class="frame tilt" data-full="/assets/sba-qc.jpg" tabindex="0" role="button" aria-label={t('zoom.aria')}><div class="bar"><i></i><i></i><i></i><span>qccx.sba.gov.sa</span></div><img src="/assets/sba-qc.jpg" alt="Saudi Bar Association complaints and reports service home page" loading="lazy" width="800" height="503"><span class="zoom"><Fragment set:html={t('zoom')} /></span></figure>
          <span class="float">🏛️ <span><Fragment set:html={t('sba.float')} /></span></span>
        </div>
        <div class="p-body">
          <div class="org"><span>Saudi Azm · Saudi Bar Association</span><span class="pill gated"><span class="d"></span><span><Fragment set:html={t('st.nafath')} /></span></span></div>
          <h3><Fragment set:html={t('sba.t')} /></h3>
