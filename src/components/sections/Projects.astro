          <section><h4>🛠 <span><Fragment set:html={t('cs.a')} /></span></h4><ul><li><Fragment set:html={t('sba.a1')} /></li><li><Fragment set:html={t('sba.a2')} /></li><li><Fragment set:html={t('sba.a3')} /></li></ul></section>
          <section><h4>🌱 <span><Fragment set:html={t('cs.r')} /></span></h4><p><Fragment set:html={t('sba.r')} /></p></section>
        </div>
      </article>

