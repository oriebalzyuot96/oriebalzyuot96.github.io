---
import { useT } from '../../i18n';
const t = useT(Astro.currentLocale);
---
<section class="sec alt" id="projects" aria-labelledby="projT">
  <div class="wrap">
    <div class="sec-title reveal"><span class="kicker"><Fragment set:html={t('pj.k')} /></span><h2 id="projT"><Fragment set:html={t('pj.t')} /></h2><p><Fragment set:html={t('pj.p')} /></p></div>
    <div class="filters" role="group" aria-label={t('pj.filter')}>
      <button class="chip" aria-pressed="true" data-f="all"><span><Fragment set:html={t('f.all')} /></span> <span class="c" data-n="all"></span></button>
      <button class="chip" aria-pressed="false" data-f="gov">🏛 <span><Fragment set:html={t('f.gov')} /></span> <span class="c" data-n="gov"></span></button>
      <button class="chip" aria-pressed="false" data-f="fin">💸 <span><Fragment set:html={t('f.fin')} /></span> <span class="c" data-n="fin"></span></button>
      <button class="chip" aria-pressed="false" data-f="saas">🏢 <span><Fragment set:html={t('f.saas')} /></span> <span class="c" data-n="saas"></span></button>
      <button class="chip" aria-pressed="false" data-f="oss">📱 <span><Fragment set:html={t('f.oss')} /></span> <span class="c" data-n="oss"></span></button>
      <button class="chip" aria-pressed="false" data-f="sample">✨ <span><Fragment set:html={t('f.sample')} /></span> <span class="c" data-n="sample"></span></button>
    </div>

    <div class="projects">
      <!-- Sample 03 -->
      <article class="card proj spot reveal" data-c="sample" id="p-sample3">
        <div class="media">
          <figure class="frame tilt" data-full="/assets/sample3.jpg" tabindex="0" role="button" aria-label={t('zoom.aria')}><div class="bar"><i></i><i></i><i></i><span>oriebalzyuot96.github.io/sample-3</span></div><img src="/assets/sample3.jpg" alt={t('s3.alt')} loading="lazy" width="1280" height="800"><span class="zoom"><Fragment set:html={t('zoom')} /></span></figure>
          <span class="float">✨ <span><Fragment set:html={t('s3.float')} /></span></span>
        </div>
        <div class="p-body">
          <div class="org"><span><Fragment set:html={t('s3.org')} /></span><span class="pill live"><span class="d"></span><span><Fragment set:html={t('st.live')} /></span></span></div>
          <h3><Fragment set:html={t('s3.t')} /></h3>
          <p><Fragment set:html={t('s3.p')} /></p>
          <ul class="hl"><li><Fragment set:html={t('s3.h1')} /></li><li><Fragment set:html={t('s3.h2')} /></li><li><Fragment set:html={t('s3.h3')} /></li></ul>
          <div class="tags"><span class="tag">Astro</span><span class="tag">Three.js</span><span class="tag">WebGL</span><span class="tag">i18n · RTL</span><span class="tag">a11y</span></div>
          <div class="p-actions"><a class="btn primary" href={Astro.currentLocale === 'ar' ? 'https://oriebalzyuot96.github.io/sample-3/ar/' : 'https://oriebalzyuot96.github.io/sample-3/'} target="_blank" rel="noopener"><Fragment set:html={t('btn.live')} /></a><a class="btn" href="https://github.com/oriebalzyuot96/sample-3" target="_blank" rel="noopener"><Fragment set:html={t('btn.code')} /></a></div>
        </div>
      </article>


      <!-- Wasl -->
      <article class="card proj spot reveal" data-c="fin" id="p-wasl">
        <div class="media">
          <div class="frame tilt"><div class="bar"><i></i><i></i><i></i><span>wasl · financing brokerage</span></div>
            <div class="mock" aria-hidden="true">
              <div class="row"><div class="box"><b>Financing request</b><div class="ln a w80"></div><div class="ln w60"></div><div class="bar-p"><i style="width:72%"></i></div></div><div class="box"><b>Offers received</b><span class="num">4</span><div class="ln w40"></div></div></div>
              <div class="offer best"><span class="row" style="align-items:center"><span class="bank" style="background:linear-gradient(135deg,#6d4aff,#b9a7ff)"></span><b>Lender A · 3.9% APR</b></span><span class="chip-s">Best match</span></div>
              <div class="offer"><span class="row" style="align-items:center"><span class="bank" style="background:linear-gradient(135deg,#0c7c5f,#a8ecd6)"></span><b>Lender B · 4.2% APR</b></span><span class="chip-s">Compare</span></div>
              <div class="offer"><span class="row" style="align-items:center"><span class="bank" style="background:linear-gradient(135deg,#cf6a10,#ffd58a)"></span><b>Lender C · 4.5% APR</b></span><span class="chip-s">Compare</span></div>
            </div>
            <span class="illus-note"><Fragment set:html={t('illus')} /></span>
          </div>
          <span class="float">🏦 <span><Fragment set:html={t('wasl.float')} /></span></span>
        </div>
        <div class="p-body">
          <div class="org"><span>Saudi Azm × National Housing Co.</span><span class="pill soon"><span class="d"></span><span><Fragment set:html={t('st.launch')} /></span></span></div>
          <h3><Fragment set:html={t('wasl.t')} /></h3>
          <div class="alt-name ar-text">منصة وصل للخدمات التمويلية</div>
          <p><Fragment set:html={t('wasl.p')} /></p>
          <ul class="hl"><li><Fragment set:html={t('wasl.h1')} /></li><li><Fragment set:html={t('wasl.h2')} /></li><li><Fragment set:html={t('wasl.h3')} /></li></ul>
          <div class="tags"><span class="tag">Angular</span><span class="tag">Signals</span><span class="tag">.NET Core</span><span class="tag">Azure</span><span class="tag">Fintech</span></div>
          <div class="p-actions"><button class="btn primary" data-case="p-wasl"><Fragment set:html={t('btn.case')} /></button><a class="btn" href="https://www.argaam.com/en/article/articledetail/id/1832972" target="_blank" rel="noopener"><Fragment set:html={t('btn.news')} /></a></div>
        </div>
        <div class="case">
          <section><h4>🎯 <span><Fragment set:html={t('cs.c')} /></span></h4><p><Fragment set:html={t('wasl.c')} /></p></section>
          <section><h4>🛠 <span><Fragment set:html={t('cs.a')} /></span></h4><ul><li><Fragment set:html={t('wasl.a1')} /></li><li><Fragment set:html={t('wasl.a2')} /></li><li><Fragment set:html={t('wasl.a3')} /></li></ul></section>
          <section><h4>🌱 <span><Fragment set:html={t('cs.r')} /></span></h4><p><Fragment set:html={t('wasl.r')} /></p></section>
        </div>
      </article>

      <!-- SBA -->
