---
import { useT } from '../../i18n';
const t = useT(Astro.currentLocale);
const TECH = [['angular', 'Angular'], ['typescript', 'TypeScript'], ['react', 'React'], ['expo', 'React Native · Expo'], ['nextdotjs', 'Next.js'], ['astro', 'Astro'], ['svelte', 'Svelte'], ['reactivex', 'RxJS'], ['ngrx', 'NgRx · NGXS'], ['redux', 'Redux'], ['socketdotio', 'WebSockets · SignalR'], ['dotnet', '.NET Core'], ['nodedotjs', 'Node.js'], ['microsoftsqlserver', 'SQL Server'], ['postgresql', 'PostgreSQL'], ['microsoftazure', 'Azure'], ['playwright', 'Playwright'], ['docker', 'Docker'], ['githubactions', 'CI/CD'], ['figma', 'Figma'], ['jira', 'Jira']];
---
<section class="sec" id="skills-sec" aria-labelledby="skillsT">
  <div class="wrap">
    <div class="sec-title reveal"><span class="kicker"><Fragment set:html={t('sk.k')} /></span><h2 id="skillsT"><Fragment set:html={t('sk.t')} /></h2><p><Fragment set:html={t('sk.p')} /></p></div>
    <div class="sk-stage reveal" aria-hidden="true">
      <div class="orbit">
        <div class="orbit-ring r1"><span class="oi" style="--a:0deg;--rad:calc(var(--ow) * .28)"><img src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/angular.svg" alt="" width="22" height="22" loading="lazy"></span><span class="oi" style="--a:90deg;--rad:calc(var(--ow) * .28)"><img src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/typescript.svg" alt="" width="22" height="22" loading="lazy"></span><span class="oi" style="--a:180deg;--rad:calc(var(--ow) * .28)"><img src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/react.svg" alt="" width="22" height="22" loading="lazy"></span><span class="oi" style="--a:270deg;--rad:calc(var(--ow) * .28)"><img src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/astro.svg" alt="" width="22" height="22" loading="lazy"></span></div>
        <div class="orbit-ring r2"><span class="oi" style="--a:0deg;--rad:calc(var(--ow) * .42)"><img src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/nodedotjs.svg" alt="" width="22" height="22" loading="lazy"></span><span class="oi" style="--a:60deg;--rad:calc(var(--ow) * .42)"><img src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/dotnet.svg" alt="" width="22" height="22" loading="lazy"></span><span class="oi" style="--a:120deg;--rad:calc(var(--ow) * .42)"><img src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/postgresql.svg" alt="" width="22" height="22" loading="lazy"></span><span class="oi" style="--a:180deg;--rad:calc(var(--ow) * .42)"><img src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/docker.svg" alt="" width="22" height="22" loading="lazy"></span><span class="oi" style="--a:240deg;--rad:calc(var(--ow) * .42)"><img src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/nextdotjs.svg" alt="" width="22" height="22" loading="lazy"></span><span class="oi" style="--a:300deg;--rad:calc(var(--ow) * .42)"><img src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/expo.svg" alt="" width="22" height="22" loading="lazy"></span></div>
        <div class="orbit-ring r3"><span class="oi" style="--a:0deg;--rad:calc(var(--ow) * .54)"><img src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/figma.svg" alt="" width="22" height="22" loading="lazy"></span><span class="oi" style="--a:45deg;--rad:calc(var(--ow) * .54)"><img src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/githubactions.svg" alt="" width="22" height="22" loading="lazy"></span><span class="oi" style="--a:90deg;--rad:calc(var(--ow) * .54)"><img src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/svelte.svg" alt="" width="22" height="22" loading="lazy"></span><span class="oi" style="--a:135deg;--rad:calc(var(--ow) * .54)"><img src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/reactivex.svg" alt="" width="22" height="22" loading="lazy"></span><span class="oi" style="--a:180deg;--rad:calc(var(--ow) * .54)"><img src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/git.svg" alt="" width="22" height="22" loading="lazy"></span><span class="oi" style="--a:225deg;--rad:calc(var(--ow) * .54)"><img src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/jest.svg" alt="" width="22" height="22" loading="lazy"></span><span class="oi" style="--a:270deg;--rad:calc(var(--ow) * .54)"><img src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/html5.svg" alt="" width="22" height="22" loading="lazy"></span><span class="oi" style="--a:315deg;--rad:calc(var(--ow) * .54)"><img src="https://cdn.jsdelivr.net/npm/simple-icons@11/icons/jira.svg" alt="" width="22" height="22" loading="lazy"></span></div>
        <div class="orbit-core"><img src="/assets/orieb-face.jpg" alt="" width="120" height="120" loading="lazy"></div>
      </div>
      <div class="tech-marq"><div class="tm-track">{[0, 1].map(() => TECH.map(([ic, n]) => <span><img src={`https://cdn.jsdelivr.net/npm/simple-icons@11/icons/${ic}.svg`} alt="" width="20" height="20" loading="lazy">{n}</span>))}</div></div>
    </div>
    <div class="skill-grid">
      <div class="card sk spot reveal"><h3><span class="ico">🎨</span><span><Fragment set:html={t('sk.fe')} /></span></h3><ul data-skills="angular|Angular · AngularJS → v22|x,typescript|TypeScript · JavaScript|x,html5|HTML5 · CSS3 · SCSS|x,reactivex|RxJS · Signals|x,ngrx|NgRx · NGXS|a,redux|Redux|a,react|React|a,nextdotjs|Next.js|a,astro|Astro|a,svelte|Svelte|p,primeng|PrimeNG|x,css|CSS · RTL · design tokens|x"></ul></div>
      <div class="card sk spot reveal"><h3><span class="ico">📱</span><span><Fragment set:html={t('sk.mo')} /></span></h3><ul data-skills="react|React Native|a,expo|Expo|a,pwa|PWA|p"></ul><h3 style="margin-top:22px"><span class="ico">🗄️</span><span><Fragment set:html={t('sk.db')} /></span></h3><ul data-skills="microsoftsqlserver|SQL Server|a,postgresql|PostgreSQL|a,mongodb|MongoDB|p,mysql|SQL|a"></ul></div>
      <div class="card sk spot reveal"><h3><span class="ico">⚙️</span><span><Fragment set:html={t('sk.be')} /></span></h3><ul data-skills="dotnet|.NET Core · C#|a,nodedotjs|Node.js · Express|a,openapiinitiative|RESTful APIs · Microservices|x,python|Python|p"></ul><h3 style="margin-top:22px"><span class="ico">☁️</span><span><Fragment set:html={t('sk.ops')} /></span></h3><ul data-skills="docker|Docker|a,githubactions|CI/CD|a,microsoftazure|Microsoft Azure|a,git|Git|x"></ul></div>
      <div class="card sk spot reveal"><h3><span class="ico">♿</span><span><Fragment set:html={t('sk.q')} /></span></h3><ul data-skills="w3c|WCAG accessibility|x,jest|Unit testing|a,playwright|Playwright end-to-end|a,owasp|App security|a,github|Code review|x,googlechrome|Responsive · cross-browser|x"></ul><h3 style="margin-top:22px"><span class="ico">⚡</span><span><Fragment set:html={t('sk.rt')} /></span></h3><ul data-skills="socketdotio|WebSockets · SignalR · SSE|a,dotnet|Real-time notifications · chat|a,reactivex|RxJS live streams|x,grafana|Live dashboards · alerts · tracking|a"></ul></div>
      <div class="card sk spot reveal"><h3><span class="ico">✏️</span><span><Fragment set:html={t('sk.ds')} /></span></h3><ul data-skills="figma|Figma · mockups to UI|x,adobe|Adobe XD|a,maildotru|HTML email templates · RTL|a,behance|Behance case studies|a,jira|Agile · Scrum · Jira|x"></ul></div>
      <div class="card sk spot reveal"><h3><span class="ico">🤖</span><span><Fragment set:html={t('sk.ai')} /></span></h3><ul data-skills="anthropic|Claude · Claude Code|a,anthropic|Claude API streaming|a,openai|AI help assistant · evaluation|a,cursor|Cursor|a"></ul></div>
    </div>
    <div class="legend reveal"><span><span class="lv x"><Fragment set:html={t('lv.x')} /></span></span><span><span class="lv a"><Fragment set:html={t('lv.a')} /></span></span><span><span class="lv p"><Fragment set:html={t('lv.p')} /></span></span></div>
  </div>
</section>
