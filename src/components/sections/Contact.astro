---
import { useT } from '../../i18n';
const t = useT(Astro.currentLocale);
---
<section class="sec" id="contact" style="padding-top:0" aria-labelledby="contactT">
  <div class="wrap">
    <div class="card contact reveal">
      <div class="avatars"><img src="/assets/orieb.jpg" alt="" width="96" height="96"></div>
      <h2 id="contactT"><Fragment set:html={t('ct2.t')} /></h2>
      <p><Fragment set:html={t('ct2.p')} /></p>
      <div class="c-grid">
        <div class="c-card"><small><Fragment set:html={t('i.email')} /></small><a class="ltr" href="mailto:alzuotorieb9999@gmail.com"><span>alzuotorieb9999@gmail.com</span></a><button class="copy" data-copy="alzuotorieb9999@gmail.com"><Fragment set:html={t('copy')} /></button></div>
        <div class="c-card"><small>WhatsApp</small><a class="ltr" href="https://wa.me/962775853203" target="_blank" rel="noopener"><span>+962 77585 3203</span></a><button class="copy" data-copy="+962775853203"><Fragment set:html={t('copy')} /></button></div>
        <a class="c-card" href="https://www.linkedin.com/in/orieb-alzyuot996" target="_blank" rel="noopener"><small>LinkedIn</small><span class="ltr">in/orieb-alzyuot996 ↗</span></a>
        <a class="c-card" href="https://github.com/oriebalzyuot96" target="_blank" rel="noopener"><small>GitHub</small><span class="ltr">oriebalzyuot96 ↗</span></a>
      </div>
      <div class="avail"><span><Fragment set:html={t('av.1')} /></span><span><Fragment set:html={t('av.2')} /></span><span><Fragment set:html={t('av.3')} /></span><span><Fragment set:html={t('av.4')} /></span><span><Fragment set:html={t('av.5')} /></span></div>
    </div>
  </div>
</section>
