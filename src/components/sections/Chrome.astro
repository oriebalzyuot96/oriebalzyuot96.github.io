---
import { useT } from '../../i18n';
const t = useT(Astro.currentLocale);
const isHome = ['/', '/ar/', '/ar'].includes(Astro.url.pathname);
---
<nav class="skips" aria-label={t('skip.nav')}><a class="skip" href="#main"><Fragment set:html={t('skip')} /></a>{isHome && <><a class="skip" href="#projects"><Fragment set:html={t('skip.projects')} /></a><a class="skip" href="#contact"><Fragment set:html={t('skip.contact')} /></a></>}</nav>
<div class="progress" id="progress" aria-hidden="true"></div>
