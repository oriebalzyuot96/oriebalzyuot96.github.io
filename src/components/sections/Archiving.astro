    <div class="sec-title reveal"><span class="kicker"><Fragment set:html={t('ar.k')} /></span><h2 id="archT"><Fragment set:html={t('ar.t')} /></h2></div>
    <div class="arch">
      <a class="card spot reveal" href="https://github.com/oriebalzyuot96" target="_blank" rel="noopener">
        <div class="logo"><span class="ico"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.7 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.1 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5z"></path></svg></span>GitHub</div>
        <div class="url">github.com/oriebalzyuot96</div>
        <p><Fragment set:html={t('ar.gh')} /></p>
        <ul><li><Fragment set:html={t('ar.gh1')} /></li><li><Fragment set:html={t('ar.gh2')} /></li><li><Fragment set:html={t('ar.gh3')} /></li></ul>
      </a>
      <a class="card spot reveal" href="https://www.linkedin.com/in/orieb-alzyuot996" target="_blank" rel="noopener">
        <div class="logo"><span class="ico"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.3c0-1.3 0-2.9-1.8-2.9s-2 1.4-2 2.8V21H9z"></path></svg></span>LinkedIn</div>
        <div class="url">in/orieb-alzyuot996</div>
        <p><Fragment set:html={t('ar.li')} /></p>
        <ul><li>Angular · React · Node.js</li><li>JavaScript · TypeScript</li><li><Fragment set:html={t('ar.li3')} /></li></ul>
      </a>
      <a class="card spot reveal" href="/Orieb-Alzyuot-CV.pdf" target="_blank" rel="noopener">
        <div class="logo"><span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><path d="M14 3v6h6M8 13h8M8 17h5"></path></svg></span><span><Fragment set:html={t('ar.cv')} /></span></div>
        <div class="url">Orieb-Alzyuot-CV.pdf</div>
        <p><Fragment set:html={t('ar.cvp')} /></p>
        <ul><li><Fragment set:html={t('ar.cv1')} /></li><li><Fragment set:html={t('ar.cv2')} /></li><li><Fragment set:html={t('ar.cv3')} /></li></ul>
