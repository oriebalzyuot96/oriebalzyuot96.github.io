---
/* A small assistant for this portfolio's public repositories. It answers from src/data/repo-bot.ts
   in the page language. Everything runs in the browser; no question leaves the page. */
import { REPOS } from '../data/repo-bot';
const ui = {
  en: {
    open: 'Ask about my repos', title: 'Repo assistant', hello: 'Hi! Ask me about any public repository, or pick a question below.',
    placeholder: 'e.g. which library can I install with npm?', send: 'Send', close: 'Close', none: "I couldn't match that to a repo. Try a name, a framework, or pick a question below.",
    chips: ['Show all repos', 'npm packages', 'Captcha', 'Components'], listLead: 'Public repositories:', npmLead: 'Install with npm:'
  },
  ar: {
    open: 'اسأل عن مستودعاتي', title: 'مساعد المستودعات', hello: 'أهلًا! اسألني عن أي مستودع عام، أو اختر سؤالًا بالأسفل.',
    placeholder: 'مثال: أي مكتبة أثبّتها بـ npm؟', send: 'إرسال', close: 'إغلاق', none: 'ما قدرت أطابق سؤالك مع مستودع. جرّب اسمًا أو إطارًا، أو اختر سؤالًا بالأسفل.',
    chips: ['عرض كل المستودعات', 'حزم npm', 'كابتشا', 'مكوّنات'], listLead: 'المستودعات العامة:', npmLead: 'ثبّتها بالأمر npm:'
  }
};
const data = { repos: REPOS, ui };
---

<div class="rbot" id="repo-bot" data-bot={JSON.stringify(data)}>
  <button class="rbot-fab" type="button" aria-expanded="false" aria-controls="rbot-panel" data-fab>
    <span aria-hidden="true">💬</span><span class="rbot-fab-l" data-open-label></span>
  </button>
  <section class="rbot-panel" id="rbot-panel" role="dialog" aria-labelledby="rbot-t" hidden data-panel>
    <header>
      <h2 id="rbot-t" data-title></h2>
      <button class="rbot-x" type="button" data-close></button>
    </header>
    <div class="rbot-log" role="log" aria-live="polite" data-log></div>
    <div class="rbot-chips" data-chips></div>
    <form class="rbot-form" data-form>
      <label class="sr-only" for="rbot-q" data-ask-label></label>
      <input id="rbot-q" type="text" autocomplete="off" data-q />
      <button class="rbot-send" type="submit" data-send></button>
    </form>
  </section>
</div>

<style>
  .rbot { position: fixed; inset-inline-end: 1rem; inset-block-end: 1rem; z-index: 60; }
  .rbot-fab { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.7rem 1rem; border-radius: 999px; border: 1px solid var(--line, #d5dbe6); background: var(--accent, #1784bd); color: #fff; font: inherit; font-weight: 700; cursor: pointer; box-shadow: 0 10px 24px -10px rgb(0 0 0 / 0.45); }
  .rbot-fab:focus-visible, .rbot-x:focus-visible, .rbot-send:focus-visible, .rbot-chips button:focus-visible { outline: 3px solid var(--ring, #7cc6e8); outline-offset: 2px; }
  .rbot-panel { position: absolute; inset-inline-end: 0; inset-block-end: 3.6rem; width: min(calc(100vw - 2rem), 360px); height: min(70vh, 480px); display: flex; flex-direction: column; border-radius: 16px; overflow: hidden; background: var(--surface, #fff); color: var(--ink, #14233a); border: 1px solid var(--line, #d5dbe6); box-shadow: 0 24px 48px -16px rgb(0 0 0 / 0.5); }
  .rbot-panel[hidden] { display: none; }
  .rbot-panel header { display: flex; align-items: center; justify-content: space-between; padding: 0.7rem 0.9rem; border-block-end: 1px solid var(--line, #d5dbe6); }
  .rbot-panel h2 { margin: 0; font-size: 1rem; }
  .rbot-x { border: 0; background: none; color: inherit; font-size: 1.1rem; cursor: pointer; padding: 0.2rem 0.4rem; }
  .rbot-x::before { content: '✕'; }
  .rbot-log { flex: 1; overflow-y: auto; padding: 0.8rem; display: grid; gap: 0.5rem; align-content: start; }
  .rbot-msg { max-width: 92%; padding: 0.55rem 0.75rem; border-radius: 12px; font-size: 0.92rem; line-height: 1.5; background: var(--surface-2, #f1f5f9); }
  .rbot-msg.me { justify-self: end; background: var(--accent-wash, #e2f3fb); }
  .rbot-msg ul { margin: 0.3rem 0 0; padding-inline-start: 1.1rem; }
  .rbot-msg a { color: var(--accent-ink, #0d6a9b); font-weight: 700; }
  .rbot-msg code { font-size: 0.85em; direction: ltr; unicode-bidi: isolate; }
  .rbot-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0 0.8rem 0.6rem; }
  .rbot-chips button { border: 1px solid var(--line, #d5dbe6); background: var(--surface, #fff); color: inherit; border-radius: 999px; padding: 0.3rem 0.7rem; font: inherit; font-size: 0.8rem; cursor: pointer; }
  .rbot-form { display: flex; gap: 0.5rem; padding: 0.6rem; border-block-start: 1px solid var(--line, #d5dbe6); }
  .rbot-form input { flex: 1; min-width: 0; padding: 0.55rem 0.7rem; border-radius: 10px; border: 1px solid var(--line-strong, #aab6c8); background: var(--surface, #fff); color: inherit; font: inherit; }
  .rbot-send { padding: 0.55rem 0.9rem; border-radius: 10px; border: 0; background: var(--accent, #1784bd); color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  .sr-only { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 480px) { .rbot { inset-inline-end: 0.75rem; inset-block-end: 0.75rem; } .rbot-fab-l { display: none; } }
</style>

<script>
  type Repo = { id: string; name: string; url: string; npm?: string; en: string; ar: string; kw: string[] };
  type Ui = { open: string; title: string; hello: string; placeholder: string; send: string; close: string; none: string; chips: string[]; listLead: string; npmLead: string };
  const root = document.getElementById('repo-bot') as HTMLElement;
  const { repos, ui } = JSON.parse(root.dataset.bot || '{}') as { repos: Repo[]; ui: { en: Ui; ar: Ui } };
  const qs = <T extends Element>(s: string) => root.querySelector<T>(s)!;
  const fab = qs<HTMLButtonElement>('[data-fab]'), panel = qs<HTMLElement>('[data-panel]'), log = qs<HTMLElement>('[data-log]');
  const form = qs<HTMLFormElement>('[data-form]'), input = qs<HTMLInputElement>('[data-q]'), chips = qs<HTMLElement>('[data-chips]');
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] as string);
  // normalise Arabic spelling variants and punctuation so keywords match regardless of how they are typed
  const norm = (s: string) => s.toLowerCase().replace(/[ً-ٟـ]/g, '').replace(/[أإآ]/g, 'ا').replace(/ى/g, 'ي').replace(/ة/g, 'ه').replace(/[^\p{L}\p{N}\s.+-]/gu, ' ');
  const lang = (): 'en' | 'ar' => (document.documentElement.lang === 'ar' ? 'ar' : 'en');
  const L = (): Ui => ui[lang()];

  function paint() {
    const u = L();
    qs('[data-open-label]').textContent = u.open;
    qs('[data-title]').textContent = u.title;
    qs('[data-close]').setAttribute('aria-label', u.close);
    qs('[data-close]').setAttribute('title', u.close);
    qs('[data-ask-label]').textContent = u.placeholder;
    input.placeholder = u.placeholder;
    qs('[data-send]').textContent = u.send;
    chips.innerHTML = u.chips.map((c, i) => `<button type="button" data-chip="${i}">${esc(c)}</button>`).join('');
  }
  function add(html: string, me = false) {
    const d = document.createElement('div');
    d.className = 'rbot-msg' + (me ? ' me' : '');
    d.innerHTML = html;
    log.appendChild(d);
    log.scrollTop = log.scrollHeight;
  }
  const repoLink = (r: Repo) => `<a href="${r.url}" target="_blank" rel="noopener">${esc(r.name)}</a>`;
  const npmTag = (r: Repo) => (r.npm ? ` <code>npm i ${esc(r.npm)}</code>` : '');
  const listAll = () => `${esc(L().listLead)}<ul>${repos.map((r) => `<li>${repoLink(r)}${npmTag(r)}</li>`).join('')}</ul>`;
  const npmAll = () => `${esc(L().npmLead)}<ul>${repos.filter((r) => r.npm).map((r) => `<li>${repoLink(r)}<br><code>npm i ${esc(r.npm!)}</code></li>`).join('')}</ul>`;

  // generic words describe a whole category (every repo is a library, in npm...), so they never pick one repo
  const GENERIC = new Set(['library', 'libraries', 'component', 'components', 'ui', 'npm', 'install', 'package', 'packages', 'repo', 'repos', 'repository', 'repositories', 'مكتبه', 'مكتبات', 'مكونات', 'واجهه', 'حزم', 'ثبت', 'مستودع', 'مستودعات']);
  const bestRepo = (text: string) => {
    let best: Repo | null = null, score = 0;
    for (const r of repos) {
      const hits = r.kw.filter((k) => !GENERIC.has(norm(k)) && text.includes(norm(k))).length + (text.includes(norm(r.name)) ? 3 : 0);
      if (hits > score) { best = r; score = hits; }
    }
    return best;
  };
  // the answer for a question: greetings, the full list, a specific repo, the npm packages, else nothing
  function answer(q: string): string | null {
    const text = norm(q).trim();
    if (!text) return null;
    if (/^(hi|hello|hey|salam|مرحبا|اهلا|هلا|سلام|السلام)/.test(text)) return esc(L().hello);
    if (/\b(all|list|every|repos?|repositories)\b|كل|جميع|المستودعات|عرض/.test(text)) return listAll();
    const specific = bestRepo(text);
    if (specific) return `${repoLink(specific)}: ${esc(lang() === 'ar' ? specific.ar : specific.en)}${npmTag(specific)}`;
    if (/\bnpm\b|install|package|library|libraries|ثبت|مكتبه|مكتبات|حزم/.test(text)) return npmAll();
    return null;
  }
  function ask(q: string) {
    if (!q.trim()) return;
    add(esc(q), true);
    add(answer(q) ?? esc(L().none));
    input.value = '';
  }
  function open(v: boolean) {
    panel.hidden = !v;
    fab.setAttribute('aria-expanded', String(v));
    if (v) { if (!log.childElementCount) add(esc(L().hello)); input.focus(); } else fab.focus();
  }

  paint();
  fab.addEventListener('click', () => open(panel.hidden));
  qs('[data-close]').addEventListener('click', () => open(false));
  panel.addEventListener('keydown', (e) => { if (e.key === 'Escape') open(false); });
  form.addEventListener('submit', (e) => { e.preventDefault(); ask(input.value); });
  chips.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-chip]');
    if (!b) return;
    const i = Number(b.dataset.chip);
    add(esc(L().chips[i]), true);
    add(i === 0 ? listAll() : i === 1 ? npmAll() : (answer(L().chips[i]) ?? esc(L().none)));
  });
</script>
