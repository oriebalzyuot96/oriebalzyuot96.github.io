---
/* Clean, import-friendly article layout (Medium "Import a story" reads the <article> element).
   Static HTML stays Medium-safe: plain <pre><code>, images, lists. Everything interactive
   (code colours, GIF → video swap, live demos) is added client-side by blog-enhance.ts. */
const { frontmatter } = Astro.props;
const SITE = 'https://oriebalzyuot96.github.io';
const url = SITE + Astro.url.pathname;
const cover = frontmatter.cover ? (frontmatter.cover.startsWith('http') ? frontmatter.cover : SITE + frontmatter.cover) : SITE + '/assets/orieb.jpg';
const ld = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: frontmatter.title, description: frontmatter.description,
  datePublished: frontmatter.date, author: { '@type': 'Person', name: 'Orieb Alzyuot', url: SITE }, image: cover, mainEntityOfPage: url,
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{frontmatter.title} · Orieb Alzyuot</title>
<meta name="description" content={frontmatter.description}>
<meta name="author" content="Orieb Alzyuot">
<link rel="canonical" href={url}>
<meta property="og:type" content="article">
<meta property="og:title" content={frontmatter.title}>
<meta property="og:description" content={frontmatter.description}>
<meta property="og:url" content={url}>
<meta property="og:image" content={cover}>
{frontmatter.cover && <meta property="og:image:width" content="1400">}
{frontmatter.cover && <meta property="og:image:height" content="788">}
<meta property="article:author" content="Orieb Alzyuot">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content={cover}>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pretendard@1.3.9/dist/web/static/pretendard.css">
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
<style is:global>
  :root{--ink:#1d1a2b;--ink2:#4f4968;--acc:#6d4aff;--soft:#f3efff;--line:#e6e1f5;--bg:#fff;--code-bg:#17142a;--code-ink:#ece8ff;color-scheme:light dark}
  @media (prefers-color-scheme:dark){:root{--ink:#f2efff;--ink2:#bdb5dc;--acc:#b9a7ff;--soft:#211a3a;--line:#2f2850;--bg:#120e20;--code-bg:#1b1631}}
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);font:18px/1.75 Pretendard,system-ui,sans-serif}
  header.bh,footer.bf{max-width:760px;margin:0 auto;padding:22px 20px;display:flex;justify-content:space-between;align-items:center;gap:12px;font-size:15px}
  header.bh a,footer.bf a{color:var(--acc);text-decoration:none;font-weight:700}
  article{overflow-wrap:break-word;max-width:760px;margin:0 auto;padding:10px 20px 40px}
  .meta{color:var(--ink2);font-size:15px;margin-bottom:8px}
  article h1{font-size:clamp(32px,5vw,46px);line-height:1.12;letter-spacing:-.03em;margin:.2em 0 .5em}
  article h2{font-size:28px;letter-spacing:-.02em;margin:1.8em 0 .5em;line-height:1.25}
  article h3{font-size:21px;letter-spacing:-.01em;margin:1.5em 0 .4em;line-height:1.3}
  article a{color:var(--acc);overflow-wrap:anywhere}
  article p,article li{color:var(--ink)}
  article blockquote{margin:1.4em 0;padding:.6em 1.2em;border-inline-start:4px solid var(--acc);background:var(--soft);border-radius:0 12px 12px 0}
  article pre{max-width:100%;padding:16px 18px;border-radius:12px;overflow-x:auto;font-size:14.5px;line-height:1.6;background:var(--code-bg);color:var(--code-ink);border:1px solid #2c2650}
  article code{font-family:"JetBrains Mono","Cascadia Code",Consolas,monospace;font-size:.88em}
  article pre code{font-size:inherit;background:none;padding:0}
  article :not(pre)>code{background:var(--soft);padding:.12em .4em;border-radius:6px}
  article table{border-collapse:collapse;width:100%;font-size:16px;margin:1.2em 0;display:block;overflow-x:auto}
  article th,article td{border:1px solid var(--line);padding:8px 12px;text-align:start}
  article th{background:var(--soft)}
  article hr{border:0;border-top:1px solid var(--line);margin:2em 0}
  article img,article video{max-width:100%;height:auto;display:block;border-radius:12px}
  article figure{margin:1.6em 0}
  article figcaption{font-size:15px;color:var(--ink2);text-align:center;margin-top:8px;line-height:1.5}
  article .try-live{font-weight:700}
  /* code tokens (blog-enhance.ts) */
  .tk-c{color:#8f88b5;font-style:italic}.tk-s{color:#a5e8b8}.tk-n{color:#ffc58a}.tk-k{color:#ff9ad5}.tk-a{color:#c3a6ff}.tk-p{color:#8fd3ff}.tk-v{color:#ffd479}.tk-f{color:#7ee0d2}
</style>
</head>
<body>
<header class="bh"><a href="/">← Orieb Alzyuot</a><a href="/#contact">Hire me</a></header>
<main id="main">
<article>
  <div class="meta">By Orieb Alzyuot · {new Date(frontmatter.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })} · {frontmatter.readTime}</div>
  <slot />
</article>
</main>
<footer class="bf"><span>© 2026 Orieb Alzyuot</span><a href="/">oriebalzyuot96.github.io</a></footer>
<script>
  import { enhance } from '../scripts/blog-enhance';
  enhance();
</script>
</body>
</html>
